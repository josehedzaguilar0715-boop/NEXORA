{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "admin:create": "tsx src/admin-cli.ts",
    "build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "e2e": "tsx test/e2e/caja.e2e.ts",
    "check": "npm run typecheck && vitest run && npm run build && npm run e2e",
    "backup": "tsx scripts/backup.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build:worker": "npm run build && tsx scripts/embed-assets.ts && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build:worker && wrangler deploy",
    "restore": "tsx scripts/restore.ts",
    "deploy:prod": "npm run build:worker && wrangler deploy --env production"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
